    "delta_values": [-2, -1, 0, 1, 2],
    "note": "Theo Agarwal et al. (IEEE TSC 2024): Δ ∈ {-2..+2} mỗi chu kỳ quyết định 30s"
  },
  "decision_period_sec": 30,
  "replica_bounds": { "min": 1, "max": 15, "max_total": 26, "max_step": 2 }
